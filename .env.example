# ============================================================================
# 环境变量样例：复制成 .env 后填入自己的值（.env 已被 .gitignore 忽略）
#   cp .env.example .env
#   bash scripts/run-api.sh        # 会自动加载 .env
# ============================================================================

# ---- 大模型（任选一个，必填；不填则智能体调用会失败）----
T2SQL_LLM_API_KEY=sk-your-key-here
# 兼容 OpenAI 协议的服务地址与模型（默认 DeepSeek）
# T2SQL_LLM_BASE_URL=https://api.deepseek.com
# T2SQL_LLM_MODEL=deepseek-flash

# ---- MySQL ----
# 值里含 & 等特殊字符时必须加引号
T2SQL_DB_URL='jdbc:mysql://127.0.0.1:3306/ecommerce?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
T2SQL_DB_USER=root
T2SQL_DB_PASSWORD=your_password

# ---- 服务端口（WebFlux 版默认 8081）----
# T2SQL_HTTP_PORT=8080

# ---- 评估工具（eval/）----
# T2SQL_JUDGE_MODEL=deepseek-flash
